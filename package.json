{
  "name": "quaid-api",
  "type": "module",
  "description": "background checks api for quaid.ai",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.398.0",
    "@aws-sdk/lib-dynamodb": "^3.398.0",
    "aws-lambda": "^1.0.7",
    "esbuild": "^0.27.2",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/aws-lambda": "^8.10.159",
    "aws-sdk-client-mock": "^2.0.0",
    "eslint": "^9.39.2",
    "jest": "^29.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "scripts": {
    "lint": "eslint src/",
    "compile": "tsc"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/__tests__/**/*.mjs?(x)",
      "**/?(*.)+(spec|test).mjs?(x)"
    ],
    "moduleFileExtensions": [
      "mjs",
      "js"
    ]
  }
}
